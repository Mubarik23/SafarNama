# =========================================================
# SafarNama PK - Example Environment Variables Template
# =========================================================
# Copy this file to .env.local and fill in your actual API keys.

# Google Gemini AI Studio API Key (for SafarAI trip planner)
GEMINI_API_KEY=your-gemini-api-key

# Carto / Map Tile API Key
CARTO_API_KEY=your-carto-api-key

# Supabase Project Credentials (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
